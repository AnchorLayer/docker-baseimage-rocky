            {
              "id": "CVE-2026-57062-gnupg2",
              "name": "RpmMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-57062 low vulnerability for gnupg2 package"
              },
              "fullDescription": {
                "text": "A flaw in GnuPG's gpgsm component improperly handles the Cryptographic Message Syntax (CMS) format for AES-GCM. By accepting an authentication tag length of 4 bytes instead of the required 12 bytes, this vulnerability allows for a low-impact data integrity issue where the cryptographic validity of messages could be compromised."
              },
              "helpUri": "https://access.redhat.com/security/cve/CVE-2026-57062",
              "help": {
                "text": "Vulnerability CVE-2026-57062\nSeverity: low\nPackage: gnupg2\nVersion: 2.3.3-5.el9_7\nFix Version: \nType: rpm\nLocation: /var/lib/rpm/rpmdb.sqlite\nData Namespace: redhat:distro:redhat:9\nLink: [CVE-2026-57062](https://access.redhat.com/security/cve/CVE-2026-57062)",
