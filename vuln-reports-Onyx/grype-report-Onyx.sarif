            {
              "id": "CVE-2026-8927-libcurl",
              "name": "RpmMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-8927 high vulnerability for libcurl package"
              },
              "fullDescription": {
                "text": "A flaw was found in libcurl. When reusing a libcurl handle for sequential transfers with environment-variable proxy configuration, the library does not properly clear the proxy authentication state. This oversight can lead to the unintended disclosure of `Proxy-Authorization` headers to an incorrect proxy, potentially exposing sensitive authentication information to an unauthorized entity. This is an information disclosure vulnerability."
              },
              "helpUri": "https://access.redhat.com/security/cve/CVE-2026-8927",
              "help": {
                "text": "Vulnerability CVE-2026-8927\nSeverity: high\nPackage: libcurl\nVersion: 7.76.1-43.el9\nFix Version: 0:7.76.1-44.el9_9.1\nType: rpm\nLocation: /var/lib/rpm/rpmdb.sqlite\nData Namespace: redhat:distro:redhat:9\nLink: [CVE-2026-8927](https://access.redhat.com/security/cve/CVE-2026-8927)",
