            {
              "id": "CVE-2026-121757-glibc",
              "name": "RpmMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-121757 medium vulnerability for glibc package"
              },
              "fullDescription": {
                "text": "A flaw was found in the GNU C Library (glibc). This vulnerability allows an attacker to cause a Denial of Service (DoS) by crashing the application. When converting specially crafted CP949 encoded text to UTF-8 with invalid character handling enabled, the iconv character converter advances the read buffer pointer past the end of the buffer. An attacker providing malicious input can trigger this out-of-bounds read condition, resulting in an application crash."
              },
              "helpUri": "https://access.redhat.com/security/cve/CVE-2026-121757",
