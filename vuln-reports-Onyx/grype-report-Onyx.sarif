            {
              "id": "CVE-2026-44605-rpm",
              "name": "RpmMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-44605 low vulnerability for rpm package"
              },
              "fullDescription": {
                "text": "A flaw was found in the RPM Package Manager (RPM). A local user could be affected by a heap buffer overflow vulnerability when processing a specially crafted NDB database file. This issue arises from an error in how RPM handles certain calculations during file parsing, leading to an incorrect memory allocation. An attacker could leverage this to cause a denial of service, making the system unavailable."
              },
              "helpUri": "https://access.redhat.com/security/cve/CVE-2026-44605",
              "help": {
