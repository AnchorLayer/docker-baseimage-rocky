            {
              "id": "CVE-2026-22185-openldap",
              "name": "RpmMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-22185 medium vulnerability for openldap package"
              },
              "fullDescription": {
                "text": "A flaw was found in OpenLDAP Lightning Memory-Mapped Database (LMDB) mdb_load. When processing malformed input, a local attacker can exploit a heap buffer underflow vulnerability in the readline() function. This can lead to an out-of-bounds read, potentially causing a denial of service (DoS) and limited disclosure of heap memory contents."
              },
              "helpUri": "https://access.redhat.com/security/cve/CVE-2026-22185",
