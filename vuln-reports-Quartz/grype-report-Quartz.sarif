            {
              "id": "CVE-2026-92386-curl",
              "name": "RpmMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-92386 low vulnerability for curl package"
              },
              "fullDescription": {
                "text": "A flaw was found in curl. A remote malicious server can trigger a denial of service (DoS) in cookie handling by providing an overly long cookie name and value that exceeds curl's line-length limit when saved to a cookie file. Subsequent curl operations reading from this cookie file silently abort parsing upon encountering the oversized entry, causing all remaining valid cookies in the file to be ignored."
              },
              "helpUri": "https://access.redhat.com/security/cve/CVE-2026-92386",
