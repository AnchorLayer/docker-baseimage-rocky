            {
              "id": "CVE-2026-107929-curl",
              "name": "RpmMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-107929 low vulnerability for curl package"
              },
              "fullDescription": {
                "text": "A flaw was found in curl. When connection pooling is used with forced local interface binding options, curl fails to include the source interface configuration in its connection reuse cache. An attacker able to initiate network requests in an application using pooled connections can cause subsequent transfers to inadvertently reuse an existing connection. This behavior causes outbound network traffic to be transmitted through the wrong source address, potentially routing requests through an unintended network interface."
              },
              "helpUri": "https://access.redhat.com/security/cve/CVE-2026-107929",
