            {
              "id": "CVE-2026-119377-sqlite-libs",
              "name": "RpmMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-119377 low vulnerability for sqlite-libs package"
              },
              "fullDescription": {
                "text": "A flaw was found in SQLite. When processing queries that use a RIGHT or FULL JOIN with a USING clause, SQLite fails to validate authorization restrictions on all joined tables. An attacker capable of submitting SQL queries can exploit this flaw to bypass access control restrictions and read protected column data."
              },
              "helpUri": "https://access.redhat.com/security/cve/CVE-2026-119377",
              "help": {
                "text": "Vulnerability CVE-2026-119377\nSeverity: low\nPackage: sqlite-libs\nVersion: 3.46.1-6.el10_2\nFix Version: \nType: rpm\nLocation: /usr/lib/sysimage/rpm/rpmdb.sqlite\nData Namespace: redhat:distro:redhat:10\nLink: [CVE-2026-119377](https://access.redhat.com/security/cve/CVE-2026-119377)",
